# ==========================================
# SAATHI-AI Environment Configuration Example
# Copy this file to .env and fill in values.
# ==========================================

# Backend Configuration
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./saathi_dev.db
ALLOWED_ORIGINS=http://localhost:3000

# ── Engine 1: Speech-to-Text & Briefings (OpenAI / OpenAI-compatible Gateway) ──
# Required for live transcription. Get your key from https://platform.openai.com
# If not set, the system automatically uses free live speech recognition fallback.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Set base URL if using local gateway or custom proxy (e.g., http://127.0.0.1:20128/v1)
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1

# ── Engine 2: Future Providers (Phase 2) ──────────────────────────────────────
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
